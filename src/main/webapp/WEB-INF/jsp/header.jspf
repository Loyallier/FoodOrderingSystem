<%@ page import="com.foodorder.model.User, com.foodorder.model.Cart" %>
<%
String ctx = request.getContextPath();
User currentUser = (User) session.getAttribute("currentUser");
Cart navCart = (Cart) session.getAttribute("cart");
int cartCount = navCart == null ? 0 : navCart.getTotalQuantity();
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= request.getAttribute("pageTitle") == null ? "MellowBite" : request.getAttribute("pageTitle") %></title>
  <link rel="stylesheet" href="<%= ctx %>/assets/css/app.css">
  <script defer src="<%= ctx %>/assets/js/app.js"></script>
</head>
<body>
<header class="topbar">
  <nav class="nav">
    <a class="brand" href="<%= ctx %>/home" aria-label="MellowBite home">
      <span class="brand-mark">M</span>
      <span>MellowBite</span>
    </a>
    <div class="nav-links">
      <a href="<%= ctx %>/home">Home</a>
      <a href="<%= ctx %>/MenuServlet">Menu</a>
      <a href="<%= ctx %>/promotions">Promotions</a>
      <a class="cart-link" href="<%= ctx %>/CartServlet">Cart <span><%= cartCount %></span></a>
      <a href="<%= ctx %>/orders/history">Orders</a>
      <% if (currentUser == null) { %>
        <a href="<%= ctx %>/login">Login</a>
      <% } else { %>
        <% if (currentUser.isAdmin()) { %>
          <a href="<%= ctx %>/admin/dashboard">Admin</a>
        <% } %>
        <span class="user-chip"><%= currentUser.getUsername() %> / <%= currentUser.getRole() %></span>
        <a href="<%= ctx %>/logout">Logout</a>
      <% } %>
    </div>
  </nav>
</header>
<main class="container">
<%
String errorMessage = (String) request.getAttribute("errorMessage");
String successMessage = (String) request.getAttribute("successMessage");
if (errorMessage != null && !errorMessage.isBlank()) {
%>
  <div class="alert error"><%= errorMessage %></div>
<% } %>
<% if (successMessage != null && !successMessage.isBlank()) { %>
  <div class="alert success"><%= successMessage %></div>
<% } %>
